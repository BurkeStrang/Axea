use collections

build() -> Stack<i32>
{
    s: Stack<i32> = collections.newStack<i32>()
    p1 = s.push(10)
    p2 = s.push(20)
    p3 = s.push(30)
    return s
}

pushOne(s: Stack<i32>)
{
    p = s.push(99)
}

s = build()
top = s.peek()
called = pushOne(s)
newTop = s.peek()
last = s.pop()
count = s.length()

print("top = {top}")
print("newTop = {newTop}")
print("last = {last}")
print("count = {count}")
