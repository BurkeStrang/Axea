use collections

PriorityQueue<i32> build()
{
    jobs: PriorityQueue<i32> = collections.newPriorityQueue<i32>()
    jobs.push(30)
    jobs.push(10)
    jobs.push(20)
    return jobs
}

void pushOne(PriorityQueue<i32> jobs)
{
    jobs.push(5)
}

i32 drain(PriorityQueue<i32> jobs)
{
    total = 0
    while jobs.length() > 0
    {
        total = total + jobs.pop()
    }
    return total
}

jobs = build()
lengthAfterBuild = jobs.length()
smallest = jobs.peek()
called = pushOne(jobs)
lengthAfterPush = jobs.length()
smallestAfterPush = jobs.peek()
total = drain(jobs)
lengthAfterDrain = jobs.length()

print("lengthAfterBuild = {lengthAfterBuild}")
print("smallest = {smallest}")
print("lengthAfterPush = {lengthAfterPush}")
print("smallestAfterPush = {smallestAfterPush}")
print("total = {total}")
print("lengthAfterDrain = {lengthAfterDrain}")
