use collections

String describe([i32; 4] numbers)
{
    comma = ", "
    return "{numbers.join(comma)}"
}

report = describe([10, 20, 30, 40])

names: List<str> = collections.newList<str>()
pushed1 = names.push("ada")
pushed2 = names.push("grace")
pushed3 = names.push("linus")

firstName = names.get(0)
nameCount = names.length

print("report = {report}")
print("firstName = {firstName}")
print("nameCount = {nameCount}")
