use collections

Deque<i32> build()
{
    numbers: Deque<i32> = collections.newDeque<i32>()
    p1 = numbers.push_back(10)
    p2 = numbers.push_back(20)
    p3 = numbers.push_front(5)
    return numbers
}

void setFirst(Deque<i32> numbers)
{
    s = numbers.set(0, 99)
}

i32 sumExplicit(Deque<i32> numbers)
{
    total = 0
    i = 0
    loop
    {
        if i >= numbers.length { break }
        total = total + numbers.get(i)
        i = i + 1
    }
    return total
}

i32 drain(Deque<i32> numbers)
{
    total = 0
    while numbers.length > 0
    {
        total = total + numbers.pop_front()
    }
    return total
}

numbers = build()
lengthAfterBuild = numbers.length
middle = numbers.get(1)
front = numbers.pop_front()
back = numbers.pop_back()
lengthAfterPops = numbers.length
called = setFirst(numbers)
afterSetFirst = numbers.get(0)
forSum = sumExplicit(numbers)
total = drain(numbers)
lengthAfterDrain = numbers.length

print("lengthAfterBuild = {lengthAfterBuild}")
