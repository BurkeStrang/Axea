use collections

Map<i32,i32> build()
{
    m = collections.newMap<i32,i32>()
    m.set(1, 10)
    m.set(2, 20)
    m.set(3, 30)
    return m
}

void fillMore(Map<i32,i32> m)
{
    m.set(4, 40)
    m.set(5, 50)
    m.set(6, 60)
    m.set(7, 70)
}

Set<i32> buildSet()
{
    s = collections.newSet<i32>()
    s.add(1)
    s.add(2)
    s.add(3)
    return s
}

void fillMoreSet(Set<i32> s)
{
    s.add(4)
    s.add(5)
    s.add(6)
    s.add(7)
}

m = build()
before = m.length
called = fillMore(m)
after = m.length
v1 = m.get(1)
v7 = m.get(7)
has3 = m.contains(3)
removed = m.remove(3)
has3After = m.contains(3)

s = buildSet()
sBefore = s.length
calledSet = fillMoreSet(s)
sAfter = s.length
hasFour = s.contains(4)
removedFour = s.remove(4)
hasFourAfter = s.contains(4)

struct Point
{
    i32 x
    i32 y
}

Map<str,i32> wordCounts()
{
    counts = collections.newMap<str,i32>()
    counts.set("apple", 3)
    counts.set("banana", 5)
    counts.set("apple", 4)
    return counts
}

Set<Point> uniquePoints()
{
    seen = collections.newSet<Point>()
    seen.add(Point { x: 1  y: 1 })
    seen.add(Point { x: 1  y: 1 })
    seen.add(Point { x: 2  y: 2 })
    return seen
}

Map<str,Point> locations()
{
    places = collections.newMap<str,Point>()
    places.set("origin", Point { x: 0  y: 0 })
    places.set("home", Point { x: 3  y: 4 })
    return places
}

counts = wordCounts()
appleCount = counts.get("apple")
wordTotal = counts.length

points = uniquePoints()
pointCount = points.length
hasOrigin = points.contains(Point { x: 1  y: 1 })

places = locations()
home = places.get("home")
homeX = home.x
homeY = home.y

print("before = {before}")
print("after = {after}")
print("v1 = {v1}")
print("v7 = {v7}")
print("has3 = {has3}")
print("has3After = {has3After}")
print("sBefore = {sBefore}")
print("sAfter = {sAfter}")
print("hasFour = {hasFour}")
print("hasFourAfter = {hasFourAfter}")
print("appleCount = {appleCount}")
print("wordTotal = {wordTotal}")
print("pointCount = {pointCount}")
print("hasOrigin = {hasOrigin}")
print("homeX = {homeX}")
print("homeY = {homeY}")
