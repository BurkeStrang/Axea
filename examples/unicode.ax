i32 describe(str text)
{
    return text.length
}

ascii = "hello"
asciiLength = ascii.length
asciiBytes = ascii.bytes

accented = "héllo wörld"
accentedLength = accented.length
accentedBytes = accented.bytes

rockets = "🚀🚀🚀"
rocketsLength = rockets.length
rocketsBytes = rockets.bytes

viaFn = describe(accented)

owned = String("héllo")
ownedLength = owned.length
ownedBytes = owned.bytes

buf = Buffer()
appended = buf.append("héllo")
bufLength = buf.length
bufBytes = buf.bytes
bufCapacity = buf.capacity

print("asciiLength = {asciiLength}")
print("asciiBytes = {asciiBytes}")
print("accentedLength = {accentedLength}")
print("accentedBytes = {accentedBytes}")
print("rocketsLength = {rocketsLength}")
print("rocketsBytes = {rocketsBytes}")
print("viaFn = {viaFn}")
print("ownedLength = {ownedLength}")
print("ownedBytes = {ownedBytes}")
print("bufLength = {bufLength}")
print("bufBytes = {bufBytes}")
print("bufCapacity = {bufCapacity}")
