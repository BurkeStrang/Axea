struct User
{
    str name
    i32 age
}

str display(User user)
{
    return user.name
}

i32 birthday(User user)
{
    user.age++
    return user.age
}

i32 celebrate(User user)
{
    return birthday(user)
}

str archive(take User user)
{
    return user.name
}

u = User { name: "Burke"  age: 35 }
shown = display(u)
newAge = celebrate(u)
print("shown = {shown}")
print("newAge = {newAge}")
print("u.age = {u.age}")
archived = archive(u)
print("archived = {archived}")
