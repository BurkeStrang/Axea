struct User
{
    name: str
    age: i32
}

display(user: User) -> str
{
    user.name
}

birthday(user: User) -> i32
{
    user.age++
    user.age
}

celebrate(user: User) -> i32
{
    birthday(user)
}

archive(take user: User) -> str
{
    user.name
}

u = User { name: "Burke"  age: 35 }
shown = display(u)
newAge = celebrate(u)
archived = archive(u)
