struct Point
{
    i32 x
    i32 y
}

str describe(Point | i32 | str v)
{
    return match v
    {
        Point(p) => "a point"
        i32(n) => "a number"
        str(s) => "a string"
    }
}

i32 | str f(i32 | str x)
{
    return x
}

i32 run()
{
    p = Point { x: 1, y: 2 }
    print(describe(p))
    print(describe(5))
    print(describe("hi"))

    w: i32 | str = 5
    print(w)

    print(f(42))
    print(f("axea"))

    return 0
}

x = run()
