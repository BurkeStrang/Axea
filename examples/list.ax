use collections

build() -> List<i32>
{
    // Unqualified TypeName<T>() construction sugar - resolves to
    // collections.newList<i32>() since exactly one used module (collections)
    // declares both `struct List<T>` and a matching `newList<T>` constructor.
    numbers = List<i32>()
    p1 = numbers.push(10)
    p2 = numbers.push(20)
    p3 = numbers.push(30)
    return numbers
}

sum(numbers: List<i32>) -> i32
{
    total = 0
    i = 0
    loop
    {
        if i >= numbers.length { break }
        total = total + numbers.get(i)
        i = i + 1
    }
    return total
}

appendOne(numbers: List<i32>)
{
    p = numbers.push(99)
}

numbers = build()
total = sum(numbers)
called = appendOne(numbers)
totalAfterAppend = sum(numbers)
last = numbers.pop()
count = numbers.length

print("total = {total}")
print("totalAfterAppend = {totalAfterAppend}")
print("last = {last}")
print("count = {count}")

// A compact way to build a List<T> already populated from an array literal, and an explicit,
// honest deep copy - pushing to the clone never touches the original.
literalNumbers = collections.newListFrom<i32>([1, 2, 3])
cloneNumbers = literalNumbers.clone()
pushedToClone = cloneNumbers.push(4)
literalSum = sum(literalNumbers)
cloneSum = sum(cloneNumbers)

print("literalSum = {literalSum}")
print("cloneSum = {cloneSum}")
