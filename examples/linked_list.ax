use collections

LinkedList<i32> build()
{
    numbers: LinkedList<i32> = collections.newLinkedList<i32>()
    p1 = numbers.push_back(10)
    p2 = numbers.push_back(20)
    p3 = numbers.push_front(5)
    return numbers
}

void pushBoth(LinkedList<i32> numbers)
{
    numbers.push_front(1)
    numbers.push_back(99)
}

i32 drain(LinkedList<i32> numbers)
{
    total = 0
    while numbers.length > 0
    {
        total = total + numbers.pop_front()
    }
    return total
}

numbers = build()
lengthAfterBuild = numbers.length
front = numbers.pop_front()
back = numbers.pop_back()
lengthAfterPops = numbers.length
called = pushBoth(numbers)
lengthAfterPushBoth = numbers.length
total = drain(numbers)
lengthAfterDrain = numbers.length

print("lengthAfterBuild = {lengthAfterBuild}")
print("front = {front}")
print("back = {back}")
print("lengthAfterPops = {lengthAfterPops}")
print("lengthAfterPushBoth = {lengthAfterPushBoth}")
print("total = {total}")
print("lengthAfterDrain = {lengthAfterDrain}")
