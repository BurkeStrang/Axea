i32 sumTo(i32 limit)
{
    n = 0
    total = 0
    while n < limit
    {
        n = n + 1
        total = total + n
    }
    return total
}

i32 firstMultipleOver(i32 limit, i32 step)
{
    n = 0
    return loop
    {
        n = n + step
        if n > limit
        {
            break n
        }
    }
}

i32 sumRange(i32 start, i32 end)
{
    total = 0
    for n in start..end
    {
        total = total + n
    }
    return total
}

sum = sumTo(10)
firstOver = firstMultipleOver(20, 3)
rangeSum = sumRange(1, 5)

print("sum = {sum}")
print("firstOver = {firstOver}")
print("rangeSum = {rangeSum}")
