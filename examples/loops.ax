sumTo(limit: i32) -> i32
{
    n = 0
    total = 0
    while n < limit
    {
        n = n + 1
        total = total + n
    }
    return total
}

firstMultipleOver(limit: i32, step: i32) -> i32
{
    n = 0
    return loop
    {
        n = n + step
        if n > limit
        {
            break n
        }
    }
}

sumRange(start: i32, end: i32) -> i32
{
    total = 0
    for n in start..end
    {
        total = total + n
    }
    return total
}

sum = sumTo(10)
firstOver = firstMultipleOver(20, 3)
rangeSum = sumRange(1, 5)
