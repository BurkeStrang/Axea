struct Counter
{
    i32 value

    void increment(self)
    {
        self.value = self.value + 1
    }
}

struct Box<T>
{
    T value

    T get(self)
    {
        return self.value
    }
}

c = Counter { value: 0 }
step1 = c.increment()
step2 = c.increment()
step3 = c.increment()
print("counter = {c.value}")

intBox = Box<i32> { value: 42 }
print("intBox.get() = {intBox.get()}")

boolBox = Box<bool> { value: true }
print("boolBox.get() = {boolBox.get()}")
