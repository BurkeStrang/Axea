i32 sum([i32; 4] values)
{
    total = 0
    for v in values
    {
        total = total + v
    }
    return total
}

i32 bumpFirst([i32; 4] values)
{
    values[0] = values[0] + 1
    return values[0]
}

numbers = [10, 20, 30, 40]
total = sum(numbers)
bumped = bumpFirst(numbers)
firstNow = numbers[0]
count = numbers.length

print("total = {total}")
print("bumped = {bumped}")
print("firstNow = {firstNow}")
print("count = {count}")
