i32 sum(read slice<i32> values)
{
    total = 0
    for v in values
    {
        total = total + v
    }
    return total
}

void zeroFirst(write slice<i32> values)
{
    values[0] = 0
}

// The same `sum` accepts arrays of any size - the whole point of slice<T>.
small = [1, 2, 3]
large = [1, 2, 3, 4, 5, 6, 7]
smallSum = sum(small)
largeSum = sum(large)

cleared = zeroFirst(small)
firstAfterClear = small[0]

print("smallSum = {smallSum}")
print("largeSum = {largeSum}")
print("firstAfterClear = {firstAfterClear}")
